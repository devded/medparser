# Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated list of allowed frontend origins for CORS (no trailing slashes).
# Defaults to http://localhost:3000,http://127.0.0.1:3000 (Next.js dev) if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
